<?xml version="1.0"?>
<!-- Gerado por scripts/ros_export.py (kinova-cam): ring_d405 — D405 com o imageador esquerdo (cor e profundidade) no eixo da garra, 15°.
     URDF isolado (raiz end_effector_link), para conferir com check_urdf / RViz. -->
<robot name="kinova_cam_ring_d405">
  <link name="end_effector_link"/>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="end_effector_link"/>
    <child link="camera_mount_link"/>
    <origin xyz="0 0 0.00287" rpy="0 0 0"/>
  </joint>
  <link name="camera_mount_link">
    <visual>
      <geometry><mesh filename="package://kinova_cam_description/meshes/ring_d405_camera_half.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="ring_d405_camera_half"><color rgba="0.85 0.45 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://kinova_cam_description/meshes/ring_d405_camera_half.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <visual>
      <geometry><mesh filename="package://kinova_cam_description/meshes/ring_lower_half.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="ring_lower_half"><color rgba="0.85 0.45 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://kinova_cam_description/meshes/ring_lower_half.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0.061768 0.002981" rpy="0 -1.309 -1.5708"/>
  </joint>
  <link name="camera_link"/>
</robot>
