.venv/
# CAD de terceiros baixado por scripts/fetch_vendor.sh; versionar só os STEP
# das câmeras, convertidos à mão no Onshape (a Intel só publica .SLDPRT)
vendor/*
!vendor/D435i_Solid - D435i Solid.step
!vendor/D435i_Solid - D435i cvr.step
!vendor/D405_Solid.step
__pycache__/
# saídas: versionar só as peças e as imagens; montagens (com CAD de terceiros) se regeneram
out/*
!out/images/
!out/ring_camera_half.*
!out/ring_rgb_camera_half.*
!out/ring_stereo_camera_half.*
!out/ring_d405_camera_half.*
!out/ring_lower_half.*
# malhas das câmeras: CAD da Intel (regenerar com scripts/ros_export.py)
ros/kinova_cam_description/meshes/*_camera.stl
